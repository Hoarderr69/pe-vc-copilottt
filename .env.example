# --- Database (required) ---

# Postgres connection string. Backs every document store (VCP milestones,
# deal/company metadata, reports, HITL queue/audit log, KPI records, portfolio
# memo) plus the LangGraph checkpoint tables. Schema auto-creates on first run
# (CREATE TABLE IF NOT EXISTS) — point this at any empty Postgres instance.
# No local-file fallback: the app raises on first store access if this is unset.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- LLM (optional — Azure OpenAI) ---

# Powers live VCP extraction and report narrative generation. If unset, every
# LLM agent falls back to a deterministic offline heuristic — the app is fully
# functional for a demo without these.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# --- External data APIs ---

# SEC EDGAR — required identification header for all EDGAR requests, including
# the peer-benchmarking peer set (20-50 peers by SIC code, pulled live from EDGAR).
# Set to "<your-app-name> <your-contact-email>" per SEC's fair-access policy.
SEC_USER_AGENT=value-creation-copilot contact@example.com

# FRED (Federal Reserve Economic Data) — macro regressors (rates, inflation, etc.)
# fed into the quant forecast ensemble (STL + SARIMA + Prophet). Optional: if
# absent, the forecast just skips macro regressors rather than failing.
FRED_API_KEY=

# --- Optional: misc config (all have working defaults) ---

# Comma-separated frontend origins allowed to call this API. Defaults to local
# Vite ports — set this to your sandbox's actual frontend URL(s).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# yfinance SSL verification (exit-multiple data). Default: true.
# YFINANCE_VERIFY_SSL=true

# Fallback exit EBITDA multiple when market data is unavailable. Default: 15.0.
# DEFAULT_EXIT_EBITDA_MULTIPLE=15.0

# Demo/dev convenience CIK used by EDGAR scripts when none is specified.
# Default: Apple's CIK (0000320193).
# DEFAULT_CIK=0000320193

# --- Optional: LangSmith tracing (wraps every Azure OpenAI call) ---

# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
